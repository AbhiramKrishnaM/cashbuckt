# Copy to .env and fill in. Never commit .env.

# ── App ────────────────────────────────────────────────────
APP_URL=https://your-domain.com
TZ=Asia/Kolkata

# ── Database (Postgres stays on the Docker internal network) ──
POSTGRES_USER=cashbuckt
POSTGRES_PASSWORD=change-me
POSTGRES_DB=cashbuckt
DATABASE_URL=postgres://cashbuckt:change-me@postgres:5432/cashbuckt

# ── Webhook auth (iOS Shortcut sends X-Webhook-Secret) ─────
# Generate: openssl rand -hex 32
WEBHOOK_SECRET=

# ── Dashboard / admin auth ─────────────────────────────────
ADMIN_USERNAME=
ADMIN_PASSWORD=
# Generate: openssl rand -hex 32
SESSION_SECRET=

# ── Web Push (VAPID) ───────────────────────────────────────
# Generate: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# ── Month-end AI audit ─────────────────────────────────────
GEMINI_API_KEY=
# OPENAI_API_KEY=

# ── Backups (pg_dump → age → DigitalOcean Spaces) ──────────
BACKUP_AGE_RECIPIENT=
SPACES_ENDPOINT=https://blr1.digitaloceanspaces.com
SPACES_BUCKET=
SPACES_ACCESS_KEY=
SPACES_SECRET_KEY=
BACKUP_RETENTION_DAYS=30
